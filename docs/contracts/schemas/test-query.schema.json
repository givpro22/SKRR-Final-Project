{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skrr.dev/contracts/test-query.schema.json",
  "title": "TestQuery",
  "description": "테스트 케이스 1건의 실행 정의. AI 서버가 생성하고 실행기가 Playwright spec으로 변환한다. LLM이 임의 코드를 쓰지 못하도록 허용된 동작만 정의한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "testCaseCode", "title", "steps"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "testCaseCode": { "type": "string", "pattern": "^TC-[0-9]{2,4}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "variables": {
      "description": "{{name}} 형식으로 참조하는 테스트 데이터 값. {{name}}은 path, value, body, headers, expected에 쓸 수 있고 변수, 비밀 변수, 앞 단계의 캡처 값 순서로 찾는다. 이름이 겹치면 가드가 거부한다. AI 서버가 만든 TestQuery와 저장본(generated_spec)에서는 비어 있고, 실행할 때 백엔드가 TEST_DATA 값을 채워 startExecution에 보낸다. 실행기는 값을 spec 문자열에 넣지 않고 실행 시 주입한다.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "secretCaptures": {
      "description": "로그인 토큰처럼 다음 요청에는 쓰지만 로그, 이벤트, 실행 결과에 남기면 안 되는 캡처 이름.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/captureName" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/step" }
    },
    "dbChecks": {
      "description": "백엔드가 테스트 전후로 수행하는 읽기 전용 조회 검증. 실행기는 처리하지 않는다.",
      "type": "array",
      "items": { "$ref": "#/$defs/dbCheck" }
    },
    "crossChecks": {
      "description": "UI-04의 화면·API·DB 교차 검증 표 1행을 만드는 정의.",
      "type": "array",
      "items": { "$ref": "#/$defs/crossCheck" }
    }
  },
  "$defs": {
    "stepBase": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "testId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$" },
    "captureName": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,39}$" },
    "sameOriginPath": { "type": "string", "pattern": "^/(?!/)" },
    "httpMethod": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
    "httpHeaders": {
      "description": "요청 헤더. 값에 {{name}}을 쓸 수 있다. 예: {\"Authorization\": \"Bearer {{apiToken}}\"}. Host, Content-Length, Connection, Cookie는 실행기가 거부한다.",
      "type": "object",
      "maxProperties": 20,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$" },
      "additionalProperties": { "type": "string", "maxLength": 4096 }
    },
    "specOperation": {
      "description": "대상 사이트 API 명세의 작업. 예: POST /cart/merge",
      "type": "string",
      "pattern": "^(GET|POST|PUT|PATCH|DELETE) /"
    },
    "responseSchema": {
      "description": "expectStatus 응답의 구조. LLM이 쓰지 않고 AI 서버 코드가 대상 사이트 API 명세에서 그대로 복사한다. 명세에 응답 구조가 없으면 생략하며, 이때 결과는 NOT_CHECKED다.",
      "type": "object"
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/gotoStep" },
        { "$ref": "#/$defs/clickStep" },
        { "$ref": "#/$defs/fillStep" },
        { "$ref": "#/$defs/selectOptionStep" },
        { "$ref": "#/$defs/expectVisibleStep" },
        { "$ref": "#/$defs/expectTextStep" },
        { "$ref": "#/$defs/expectCountStep" },
        { "$ref": "#/$defs/pressStep" },
        { "$ref": "#/$defs/expectUrlStep" },
        { "$ref": "#/$defs/captureTextStep" },
        { "$ref": "#/$defs/waitForApiStep" },
        { "$ref": "#/$defs/apiRequestStep" },
        { "$ref": "#/$defs/expectCaptureStep" }
      ]
    },
    "gotoStep": {
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["action", "path"],
      "properties": {
        "id": true, "description": true,
        "action": { "const": "goto" },
        "path": { "$ref": "#/$defs/sameOriginPath" }
      },
      "unevaluatedProperties": false
    },
    "clickStep": {
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["action", "testId"],
      "properties": {
        "id": true, "description": true,
        "action": { "const": "click" },
        "testId": { "$ref": "#/$defs/testId" }
      },
      "unevaluatedProperties": false
    },
    "fillStep": {
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["action", "testId", "value"],
      "properties": {
        "id": true, "description": true,
        "action": { "const": "fill" },
        "testId": { "$ref": "#/$defs/testId" },
        "value": { "type": "string" }
      },
      "unevaluatedProperties": false
    },
    "selectOptionStep": {
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["action", "testId", "value"],
      "properties": {
        "id": true, "description": true,
        "action": { "const": "selectOption" },
        "testId": { "$ref": "#/$defs/testId" },
        "value": { "type": "string" }
      },
      "unevaluatedProperties": false
    },
    "expectVisibleStep": {
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["action", "testId"],
      "properties": {
        "id": true, "description": true,
        "action": { "const": "expectVisible" },
        "testId": { "$ref": "#/$defs/testId" },
        "visible": { "type": "boolean", "default": true }
      },
      "unevaluatedProperties": false
    },
    "expectTextStep": {
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["action", "testId", "text"],
      "properties": {
        "id": true, "description": true,
        "action": { "const": "expectText" },
        "testId": { "$ref": "#/$defs/testId" },
        "text": { "type": "string" },
        "match": { "enum": ["EXACT", "CONTAINS"], "default": "CONTAINS" }
      },
      "unevaluatedProperties": false
    },
    "expectCountStep": {
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["action", "testId", "count"],
      "properties": {
        "id": true, "description": true,
        "action": { "const": "expectCount" },
        "testId": { "$ref": "#/$defs/testId" },
        "count": { "type": "integer", "minimum": 0 }
      },
      "unevaluatedProperties": false
    },
    "pressStep": {
      "description": "키 입력. 팀 PoC의 press와 같다.",
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["action", "testId", "key"],
      "properties": {
        "id": true, "description": true,
        "action": { "const": "press" },
        "testId": { "$ref": "#/$defs/testId" },
        "key": { "type": "string", "pattern": "^[A-Za-z0-9+]{1,30}$" }
      },
      "unevaluatedProperties": false
    },
    "expectUrlStep": {
      "description": "현재 경로 확인. 로그인 후 이동처럼 화면 요소가 아닌 이동 결과를 검증한다.",
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["action", "path"],
      "properties": {
        "id": true, "description": true,
        "action": { "const": "expectUrl" },
        "path": { "$ref": "#/$defs/sameOriginPath" },
        "match": { "enum": ["EXACT", "PREFIX"], "default": "PREFIX" }
      },
      "unevaluatedProperties": false
    },
    "captureTextStep": {
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["action", "testId", "as"],
      "properties": {
        "id": true, "description": true,
        "action": { "const": "captureText" },
        "testId": { "$ref": "#/$defs/testId" },
        "as": { "$ref": "#/$defs/captureName" }
      },
      "unevaluatedProperties": false
    },
    "waitForApiStep": {
      "description": "직전 화면 동작이 일으킨 업무 API 응답을 기다려 값을 캡처한다.",
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["action", "method", "path", "trigger"],
      "properties": {
        "id": true, "description": true,
        "action": { "const": "waitForApi" },
        "method": { "$ref": "#/$defs/httpMethod" },
        "path": {
          "$ref": "#/$defs/sameOriginPath",
          "description": "기다릴 응답의 경로. 생성 때 알 수 없는 값은 OpenAPI 경로 템플릿처럼 중괄호 하나 {이름} 세그먼트로 쓰며, 실행기는 그 자리를 '/'가 없는 비어 있지 않은 세그먼트 하나로 맞춘다. 예: /api/orders/{orderId}/cancel. 실제 값이 필요하면 captures로 응답에서 받는다. {{이름}}(중괄호 둘)은 변수 치환이며 먼저 치환한다. 이 규칙은 waitForApi에만 적용하고 apiRequest·goto·expectUrl의 path에는 적용하지 않는다."
        },
        "trigger": { "$ref": "#/$defs/testId" },
        "expectStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
        "captures": { "$ref": "#/$defs/jsonCaptures" },
        "specOperation": { "$ref": "#/$defs/specOperation" },
        "responseSchema": { "$ref": "#/$defs/responseSchema" }
      },
      "unevaluatedProperties": false
    },
    "apiRequestStep": {
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["action", "method", "path"],
      "properties": {
        "id": true, "description": true,
        "action": { "const": "apiRequest" },
        "method": { "$ref": "#/$defs/httpMethod" },
        "path": { "$ref": "#/$defs/sameOriginPath" },
        "headers": { "$ref": "#/$defs/httpHeaders" },
        "body": {},
        "expectStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
        "captures": { "$ref": "#/$defs/jsonCaptures" },
        "specOperation": { "$ref": "#/$defs/specOperation" },
        "responseSchema": { "$ref": "#/$defs/responseSchema" }
      },
      "unevaluatedProperties": false
    },
    "expectCaptureStep": {
      "allOf": [{ "$ref": "#/$defs/stepBase" }],
      "required": ["action", "capture", "equals"],
      "properties": {
        "id": true, "description": true,
        "action": { "const": "expectCapture" },
        "capture": { "$ref": "#/$defs/captureName" },
        "equals": { "type": "string" }
      },
      "unevaluatedProperties": false
    },
    "jsonCaptures": {
      "description": "캡처 이름 → JSONPath 대응. 예: {\"apiTotal\": \"$.total\"}",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/captureName" },
      "additionalProperties": { "type": "string", "pattern": "^\\$" }
    },
    "dbCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "phase", "path", "jsonPath"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
        "label": { "type": "string" },
        "phase": { "enum": ["BEFORE", "AFTER"] },
        "path": {
          "$ref": "#/$defs/sameOriginPath",
          "description": "queryApiBaseUrl의 출처(scheme://host:port) 기준 전체 경로. 예: queryApiBaseUrl이 https://shop.test/api/test/query면 /api/test/query/cart-items?memberId={{memberId}}. queryApiBaseUrl의 경로로 시작해야 하며, 아니면 백엔드가 실행하지 않는다 (읽기 전용 조회 API만 부르기 위해)."
        },
        "jsonPath": { "type": "string", "pattern": "^\\$" },
        "expected": { "type": "string" }
      }
    },
    "crossCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "oneOf": [
        { "required": ["expected"], "not": { "required": ["consistencyOnly"] } },
        { "required": ["consistencyOnly", "reason"], "not": { "required": ["expected"] } }
      ],
      "properties": {
        "label": { "type": "string" },
        "uiCapture": { "$ref": "#/$defs/captureName" },
        "apiCapture": { "$ref": "#/$defs/captureName" },
        "dbCheckId": { "type": "string" },
        "expected": {
          "description": "기대값. 세 값이 서로 같아도 이 값과 다르면 불일치다.",
          "type": "string"
        },
        "consistencyOnly": {
          "description": "주문 번호처럼 미리 알 수 없는 값만 true로 둔다. 세 값이 서로 같은지만 확인한다.",
          "const": true
        },
        "reason": {
          "description": "consistencyOnly를 쓴 이유",
          "type": "string",
          "minLength": 1
        },
        "normalize": {
          "description": "비교 전 값 정규화. 예: ₩87,400과 87400을 같은 값으로 본다.",
          "enum": ["NONE", "NUMBER", "CURRENCY"],
          "default": "NONE"
        }
      }
    }
  }
}
