{
  "name": "skrr-runner",
  "version": "0.1.0",
  "private": true,
  "description": "SKRR Playwright 실행기 내부 API (TestQuery를 spec으로 변환해 실행)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.cpSync('src/contracts','dist/contracts',{recursive:true});fs.copyFileSync('src/runtime/skrr-runtime.ts','dist/runtime/skrr-runtime.ts')\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --import ./test/setup-browsers.ts --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "target-site": "node --import tsx test/fixtures/target-site/server.ts"
  },
  "dependencies": {
    "@playwright/test": "1.65.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.8",
    "jszip": "3.10.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript-eslint": "8.72.2"
  }
}
