# SKRR 로컬 실행용 환경변수 예시. `cp .env.example .env` 후 값을 채운다.
# 이 저장소는 공개 상태다. 실제 값은 .env에만 두고 커밋하지 않는다.
# 변수 이름과 의미의 기준은 docs/architecture.md "런타임 설정"이다.

# --- PostgreSQL (docker-compose의 postgres와 backend가 함께 쓴다) ---
POSTGRES_DB=skrr
POSTGRES_USER=skrr
POSTGRES_PASSWORD=

# --- 문서 저장소 (backend, ai) ---
# local(기본): AWS 없이 동작. backend가 doc-storage 볼륨에 저장하고 ai가 같은 경로에서 읽는다
# s3(선택): STORAGE_TYPE=s3, DOCUMENT_SOURCE_DIR= (비움), 아래 S3_BUCKET과 AWS 값을 채운다
STORAGE_TYPE=local
DOCUMENT_SOURCE_DIR=/data/documents
# local 다운로드 링크 서명 키(비밀). 비우면 시작할 때 임의 값을 만들어 재시작 후 이전 링크가 무효가 된다
LOCAL_STORAGE_SIGNING_KEY=

# --- AWS S3 (STORAGE_TYPE=s3일 때만 필요) ---
AWS_REGION=ap-northeast-2
S3_BUCKET=
# 클러스터 신원 연동이나 로컬 프로필을 쓰면 비워 둔다 (SDK 기본 체인)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- 대상 사이트 (backend) ---
# 대상 사이트 초기화 API 토큰 (docs/contracts/target-site-contract.md)
TEST_CONTROL_TOKEN=

# --- LLM (ai, ADR-010 미정) ---
# 결정 전에는 가짜 클라이언트를 쓴다
LLM_PROVIDER=fake
LLM_MODEL=
EMBEDDING_MODEL=
# 호스팅 API를 쓸 때만
LLM_API_KEY=
# Ollama 등 자체 호스팅을 쓸 때만
LLM_BASE_URL=

# --- 실행기 (runner) ---
# 쉼표 구분 허용 호스트. 호스트 머신의 대상 사이트는 host.docker.internal 로 접근한다
RUNNER_ALLOWED_TARGET_HOSTS=host.docker.internal,localhost

# --- Ingress Basic Auth (kind 로컬 쿠버네티스, ADR-011) ---
# infra/k8s/overlays/local/create-secrets.sh 가 htpasswd 형식으로 바꿔 Secret에 넣는다
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
